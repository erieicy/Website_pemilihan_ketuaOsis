# Nonaktifkan directory listing
Options -Indexes

# Blokir akses HTTP ke direktori/file tersembunyi (seperti .git/) kecuali .well-known/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# Blokir akses langsung ke file sensitif dan dokumentasi internal
<FilesMatch "^(\.git|installed\.lock|README\.md|LICENSE|\.gitignore|\.gitattributes)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
